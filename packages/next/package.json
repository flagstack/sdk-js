{
  "name": "@flagstack/next",
  "version": "0.0.0",
  "description": "Next.js App Router integration for FlagStack.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@flagstack/browser": "workspace:*",
    "@flagstack/node": "workspace:*",
    "@flagstack/react": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=15 <17",
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
